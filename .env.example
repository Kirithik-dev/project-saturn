# Supabase Configuration
# Replace with your project URL and public Anon / Publishable key from your Supabase Dashboard
# (Project Settings -> API). NEVER use the secret service_role key in client code.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Gemini API Key (managed by AI Studio secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL (used for OAuth redirect callbacks)
APP_URL="http://localhost:3000"
